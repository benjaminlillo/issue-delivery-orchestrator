{
  "name": "turboshop",
  "productName": "TurboShop",
  "git": {
    "defaultBase": "development",
    "prTarget": "test",
    "evidenceBranch": "codex-ui-evidence"
  },
  "runtime": {
    "root": ".local-runtime",
    "namespace": "issue-delivery-orchestrator",
    "initCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "init",
      "--profile",
      "implementation"
    ],
    "cleanupCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "cleanup",
      "--runtime",
      "{runtime_id}"
    ],
    "servicesCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "ensure-services",
      "{services}"
    ],
    "cloudServicesCommand": [
      "corepack",
      "pnpm",
      "cloud:services:ensure"
    ]
  },
  "identity": {
    "linearExpectedEmail": "",
    "githubExpectedLogin": ""
  },
  "review": {
    "botNames": [
      "coderabbit",
      "hellonston",
      "x100-production"
    ],
    "blockerBots": [
      "hellonston",
      "x100-production"
    ],
    "repairBatchSize": 5,
    "readyLabel": "ASSIGN_REVIEWER",
    "quietSeconds": 600,
    "maximumWaitSeconds": 1200,
    "pollSeconds": 15
  },
  "linear": {
    "markerPrefix": "turboshop",
    "uiSection": "UI enhancements"
  },
  "blastRadius": {
    "unitRoots": [
      "apps",
      "libs"
    ],
    "ignoredPaths": [
      "pnpm-lock.yaml",
      "docs/lessons/*"
    ],
    "testPaths": [
      "*.test.*",
      "*.spec.*",
      "*/__tests__/*",
      "*/tests/*",
      "*/test/*",
      "apps/*-e2e/*"
    ],
    "migrationPaths": [
      "apps/*/src/database/migrations/*",
      "apps/*/prisma/migrations/*",
      "apps/turbo-macroscope-migrations/*"
    ],
    "sharedLibraries": [
      "libs/shared-*"
    ],
    "importPrefix": "@turboshop/",
    "minConsumers": 2,
    "lowRiskMaxChangedLines": 400,
    "lowRiskMaxUnits": 1,
    "judgedTriggers": {
      "money": "Dinero o contabilidad ERP",
      "permissions": "Auth, permisos o aislamiento por tenant",
      "mobileContract": "Contrato con apps móviles publicadas"
    }
  }
}
