{
  "name": "turboshop",
  "productName": "TurboShop",
  "git": {
    "defaultBase": "development",
    "prTarget": "test",
    "evidenceBranch": "codex-ui-evidence"
  },
  "runtime": {
    "root": ".local-runtime",
    "namespace": "issue-delivery-orchestrator",
    "initCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "init",
      "--profile",
      "implementation"
    ],
    "cleanupCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "cleanup",
      "--runtime",
      "{runtime_id}"
    ],
    "servicesCommand": [
      "corepack",
      "pnpm",
      "local-runtime",
      "ensure-services",
      "{services}"
    ],
    "cloudServicesCommand": [
      "corepack",
      "pnpm",
      "cloud:services:ensure"
    ]
  },
  "identity": {
    "linearExpectedEmail": "",
    "githubExpectedLogin": ""
  },
  "review": {
    "botNames": [
      "coderabbit",
      "hellonston",
      "x100-production",
      "turboreview"
    ],
    "blockerBots": [
      "hellonston",
      "x100-production",
      "turboreview"
    ],
    "repairBatchSize": 5,
    "readyLabel": "ASSIGN_REVIEWER",
    "quietSeconds": 900,
    "maximumWaitSeconds": 1800,
    "pollSeconds": 15
  },
  "linear": {
    "markerPrefix": "turboshop",
    "uiSection": "UI enhancements"
  },
  "blastRadius": {
    "unitRoots": [
      "apps",
      "libs"
    ],
    "ignoredPaths": [
      "pnpm-lock.yaml",
      "docs/lessons/*"
    ],
    "testPaths": [
      "*.test.*",
      "*.spec.*",
      "*/__tests__/*",
      "*/tests/*",
      "*/test/*",
      "apps/*-e2e/*"
    ],
    "migrationPaths": [
      "apps/*/src/database/migrations/*",
      "apps/*/prisma/migrations/*",
      "apps/turbo-macroscope-migrations/*"
    ],
    "sharedLibraries": [
      "libs/shared-*"
    ],
    "importPrefix": "@turboshop/",
    "minProducts": 2,
    "productGroups": {
      "erp": [
        "backend",
        "frontend-sales"
      ],
      "shops": [
        "shops-app",
        "shops-backend"
      ],
      "shipment": [
        "shipment-app",
        "shipment-backend",
        "shipment-manager",
        "shipment-mobile-bff"
      ],
      "warehouse": [
        "warehouse-app",
        "warehouse-backend",
        "warehouse-mobile"
      ],
      "quotation": [
        "quotation-app",
        "quotation-backend",
        "internal-quotation-stock-job"
      ],
      "procurement": [
        "procurement-app",
        "procurement-backend"
      ],
      "sales-force": [
        "sales-force-app",
        "sales-force-backend"
      ],
      "turbo-macroscope": [
        "turbo-macroscope",
        "turbo-macroscope-migrations"
      ]
    },
    "lowRiskMaxChangedLines": 400,
    "lowRiskMaxUnits": 1,
    "judgedTriggers": {
      "money": "Dinero o contabilidad ERP",
      "permissions": "Auth, permisos o aislamiento por tenant",
      "mobileContract": "Contrato con apps móviles publicadas"
    }
  }
}
