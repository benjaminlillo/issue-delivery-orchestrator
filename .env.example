# Store the real file at ~/.config/issue-delivery-orchestrator/.env.
LINEAR_API_KEY=
LINEAR_EXPECTED_EMAIL=you@example.com
GITHUB_EXPECTED_LOGIN=your-github-login

# Optional: gh automatically consumes GH_TOKEN when set.
GH_TOKEN=

# Absolute path to the primary checkout of the target repository.
ISSUE_DELIVERY_REPOSITORY=

# Optional overrides.
# ISSUE_DELIVERY_PROFILE=/absolute/path/to/profile.json
# ISSUE_DELIVERY_BROWSER=/absolute/path/to/chrome-or-chromium
# SUPERSET_WORKSPACE_PATH=/absolute/path/to/superset-worktree
